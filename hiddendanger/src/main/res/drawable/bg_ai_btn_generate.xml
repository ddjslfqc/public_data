<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#331465EB">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#DCEAFF"
                android:startColor="#E9F2FF"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#C9DCFF" />
        </shape>
    </item>
</ripple>
