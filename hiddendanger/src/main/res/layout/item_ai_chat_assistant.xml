<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tv_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_ai_bubble_assistant"
        android:elevation="0dp"
        android:lineSpacingExtra="3dp"
        android:maxWidth="300dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp"
        android:textColor="#111827"
        android:textSize="15sp"
        tools:text="AI 回答内容【1】" />

    <TextView
        android:id="@+id/tv_typing_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="轻触气泡 · 跳过动画"
        android:textColor="#A0A6B3"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 元信息一行；操作/引用另起一行，避免窄屏把「复制」裁切 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_web_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="已联网"
            android:textColor="#1465EB"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_timing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="#1465EB"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="耗时 45.1s"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A0A6B3"
            android:textSize="11sp"
            tools:text="2026-09-01 17:52" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="#1465EB"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="引用 8 个来源"
            tools:visibility="visible" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_copy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="true"
            android:minHeight="28dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="复制"
            android:textColor="#1465EB"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="true"
            android:minHeight="28dp"
            android:gravity="center"
            android:layout_marginStart="2dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="删除"
            android:textColor="#A0A6B3"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_sources"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_ai_card"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingVertical="4dp"
        android:visibility="gone" />
</LinearLayout>
