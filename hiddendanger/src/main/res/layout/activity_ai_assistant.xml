<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_page"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_back_white"
            android:tint="#1A1A1A" />

        <TextView
            android:id="@+id/btn_my_reports"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_ai_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="我的"
            android:textColor="#1465EB"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_my_reports"
            android:background="@drawable/bg_ai_chip"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="新对话"
            android:textColor="#1465EB"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@id/btn_back"
            android:layout_toStartOf="@id/btn_new_chat"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="悦城助手"
                android:textColor="#111827"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_ai_status_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="1dp"
                android:text="连接中…"
                android:textColor="#686D79"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EDF5" />

    <!-- 分段：问答 / 日报（工单已隐藏） -->
    <LinearLayout
        android:id="@+id/main_segment_track"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ai_segment_track"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_segment_selected"
            android:gravity="center"
            android:text="智能问答"
            android:textColor="#1465EB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_workorder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="工单"
            android:textColor="#686D79"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tab_daily"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="写汇报"
            android:textColor="#686D79"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_knowledge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="贡献资料"
            android:textColor="#686D79"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_ai_chat_assistant" />

        <LinearLayout
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_ai_avatar"
                android:gravity="center"
                android:text="AI"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="你好，我是悦城助手"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="可以问项目资料，也可以切换上方写汇报"
                android:textColor="#898FA0"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ll_empty_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chip_suggest_1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ai_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="连江项目最近进度怎么样？"
                    android:textColor="#1465EB"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_suggest_2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ai_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="海门巡检和连江有什么区别？"
                    android:textColor="#1465EB"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chip_suggest_3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ai_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="帮我总结一下本周工作重点"
                    android:textColor="#1465EB"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/skill_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ai_page"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:fillViewport="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="28dp">

                <!-- 二级：文字下划线 Tab，放在卡片外，和主分段层次分开 -->
                <LinearLayout
                    android:id="@+id/report_sub_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_report_daily"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ai_subtab_selected"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:text="日报"
                        android:textColor="#1465EB"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tab_report_weekly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:text="周报"
                        android:textColor="#8B93A7"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tab_report_monthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingBottom="6dp"
                        android:text="月报"
                        android:textColor="#8B93A7"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E4E9F2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_skill_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="写汇报"
                        android:textColor="#111827"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_skill_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="可选择日期补写历史日报；点「生成草稿」后可再编辑提交。"
                        android:textColor="#7B8394"
                        android:textSize="13sp" />

                    <!-- 日报日期：生成草稿前即可选择 -->
                    <LinearLayout
                        android:id="@+id/row_daily_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_ai_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="日报日期"
                            android:textColor="#686D79"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_daily_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1465EB"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="2026年9月2日" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="▾"
                            android:textColor="#1465EB"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 周报周期：选任意一天，自动对齐周一～周日 -->
                    <LinearLayout
                        android:id="@+id/row_weekly_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_ai_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="报告周期"
                            android:textColor="#686D79"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_weekly_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1465EB"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="2026年8月25日 – 8月31日" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="▾"
                            android:textColor="#1465EB"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 月报月份 -->
                    <LinearLayout
                        android:id="@+id/row_monthly_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_ai_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="报告月份"
                            android:textColor="#686D79"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_monthly_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1465EB"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="2026年8月" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="▾"
                            android:textColor="#1465EB"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_skill_statement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ai_input"
                        android:gravity="top"
                        android:hint="例如：今天完成移动端接口联调，并处理了登录状态异常问题"
                        android:lineSpacingExtra="2dp"
                        android:minHeight="120dp"
                        android:padding="14dp"
                        android:textColor="#111827"
                        android:textColorHint="#A8AFBD"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/ll_skill_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_skill_voice"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_ai_send_soft"
                            android:contentDescription="语音"
                            android:padding="11dp"
                            android:src="@android:drawable/ic_btn_speak_now"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_generate"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ai_btn_generate"
                            android:gravity="center"
                            android:text="生成草稿"
                            android:textColor="#0065FD"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_skill_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ai_alert_error"
                    android:padding="12dp"
                    android:textColor="#D6413F"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- 生成中占位：避免只有按钮变「生成中…」看起来像没反应 -->
                <LinearLayout
                    android:id="@+id/draft_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ai_card"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="22dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="#1465EB" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_draft_loading_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="正在生成草稿…"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_draft_loading_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="请稍候，完成后可继续编辑再提交"
                            android:textColor="#898FA0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/draft_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ai_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ai_draft_header"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <TextView
                            android:id="@+id/tv_draft_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ai_draft_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="草稿"
                            android:textColor="#1465EB"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_draft_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="草稿预览"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:id="@+id/tv_missing_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_ai_alert_warn"
                            android:padding="10dp"
                            android:textColor="#B45309"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_draft_fields"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:descendantFocusability="afterDescendants"
                            android:orientation="vertical" />

                        <!-- 周报：关联本人 OKR 进度（单层卡片，避免框套框） -->
                        <LinearLayout
                            android:id="@+id/okr_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="关联本人 OKR 进度"
                                    android:textColor="#111827"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_okr_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_ai_draft_badge"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="#1465EB"
                                    android:textSize="11sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_okr_section_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="勾选要更新的 KR；进度只能上调。"
                                android:textColor="#7B8394"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_okr_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_ai_alert_warn"
                                android:padding="10dp"
                                android:textColor="#B45309"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/ll_okr_rows"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_submit_success"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_ai_alert_ok"
                            android:padding="12dp"
                            android:textColor="#047857"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_submit"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_ai_btn_primary"
                            android:elevation="2dp"
                            android:gravity="center"
                            android:text="确认提交"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_skill_next"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_ai_btn_outline"
                            android:gravity="center"
                            android:text="再写一条"
                            android:textColor="#1465EB"
                            android:textSize="15sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_goto_weekly"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="用本周日报生成周报 →"
                            android:textColor="#1465EB"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_view_my_reports"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="去「我的报告」查看 →"
                            android:textColor="#1465EB"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_open_orders"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="查看相关工单"
                            android:textColor="#898FA0"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/knowledge_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ai_surface_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上传资料"
                        android:textColor="#111827"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="选文件即可，无需填写项目信息；上传后自动识别，可在智能问答检索"
                        android:textColor="#898FA0"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/zone_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_ai_upload_zone"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="28dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📄"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/tv_upload_zone_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="点击选择文件"
                            android:textColor="#1465EB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_upload_zone_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="PDF · Word · 图片 · Markdown 等"
                            android:textColor="#898FA0"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_upload_now"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_ai_btn_primary"
                        android:gravity="center"
                        android:text="立即上传"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="我的上传"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_knowledge_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingVertical="28dp"
                    android:text="暂无上传记录\n点上方选择文件即可贡献资料"
                    android:textColor="#A0A6B3"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_knowledge_uploads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="#1465EB"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部输入 -->
    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <HorizontalScrollView
            android:id="@+id/chip_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_web_search"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_ai_chip"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="联网搜索"
                    android:textColor="#1465EB"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ai_input"
                android:gravity="top|start"
                android:hint="继续追问…"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp"
                android:scrollbars="vertical"
                android:textColor="#111827"
                android:textColorHint="#A0A6B3"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_voice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_ai_send_soft"
                android:contentDescription="语音"
                android:padding="11dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_ai_send"
                android:contentDescription="发送"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
