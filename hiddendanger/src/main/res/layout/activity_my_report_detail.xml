<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF1F8"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:contentDescription="返回"
            android:padding="12dp"
            android:src="@drawable/ic_back_white"
            android:tint="#1A1A1A" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="报告详情"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EDF5" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 头部：周期 + 元信息 -->
            <LinearLayout
                android:id="@+id/card_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_report_detail_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_period"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="2026年8月31日 – 9月6日" />

                <TextView
                    android:id="@+id/tv_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#898FA0"
                    android:textSize="13sp"
                    tools:text="周报 · 王健 · 提交于 2026-09-01 23:12" />

                <TextView
                    android:id="@+id/badge_okr_synced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_report_okr_synced"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="已同步 OKR"
                    android:textColor="#0F766E"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 工作总结 -->
            <LinearLayout
                android:id="@+id/card_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_report_detail_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_summary_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工作总结"
                    android:textColor="#898FA0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    tools:text="本周完成了连江手机盒的现场调试工作。" />
            </LinearLayout>

            <!-- 问题 / 支持 -->
            <LinearLayout
                android:id="@+id/card_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_report_detail_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="遇到的问题 / 需要的支持"
                    android:textColor="#898FA0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_issues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#1A1A1A"
                    android:textSize="15sp"
                    tools:text="暂无" />
            </LinearLayout>

            <!-- 关联 OKR（仅周报且有更新时展示） -->
            <LinearLayout
                android:id="@+id/card_okr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_report_detail_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="关联 OKR 进度"
                        android:textColor="#111827"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_okr_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#898FA0"
                        android:textSize="12sp"
                        tools:text="2 项已更新" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_okr_updates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_go_my_goals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="在「我的目标」查看完整 OKR →"
                    android:textColor="#1465EB"
                    android:textSize="13sp" />
            </LinearLayout>
            <!-- 周报：无 OKR 更新时也提供跳转 -->
            <TextView
                android:id="@+id/btn_go_my_goals_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_report_detail_card"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:text="在「我的目标」查看完整 OKR →"
                android:textColor="#1465EB"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- 日报：编辑 / 删除 -->
            <LinearLayout
                android:id="@+id/row_daily_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/btn_edit_daily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ai_btn_outline"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="编辑日报"
                    android:textColor="#1465EB"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_delete_daily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ai_btn_outline"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="删除日报"
                    android:textColor="#E11D48"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
